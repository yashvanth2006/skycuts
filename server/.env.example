NODE_ENV=development
PORT=5001

# ── Database ─────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dbname?appName=appName

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# Paste your Google Web Client ID from Firebase Console
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Password used by the /api/auth/seed-admin endpoint (development only)
ADMIN_SEED_PASSWORD=ChangeMe123!

# ── CORS ─────────────────────────────────────────────────────────────
MULTI_ORIGIN_CORS=http://localhost:5173,http://localhost:5175,http://localhost:5176
CLIENT_URL=http://localhost:5173

# ── AWS S3 ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-1
AWS_BUCKET_NAME=skycuts-videos

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Email (optional) ─────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=SkyCuts Studio <your-email@gmail.com>
